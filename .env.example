# Вставте сюди URL Discord webhook. Файл .env не додається до git.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tsn_academy
MYSQL_USER=tsn_academy
MYSQL_PASSWORD=change-this-password
MYSQL_SSL=true
# Для Aiven без завантаженого CA-сертифіката:
MYSQL_SSL_REJECT_UNAUTHORIZED=false
SESSION_SECRET=change-this-long-random-value
